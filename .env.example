# Environment variables for the Vercel deployment.
# Set these in Vercel > Settings > Environment Variables, NOT in a file
# you commit. On a Vercel project, DATABASE_URL is required: the bundle is
# read-only, so the app cannot fall back to a SQLite file and will refuse
# to start without it.

# --- Database ---
# Neon: Connect > Connection string > Pooled connection.
# The pooled endpoint is the one for a serverless app - it returns the
# connection after every transaction, so a handful of backend connections
# serve every request. Do NOT use the "direct" string, and avoid the
# session pooler: Vercel scales to many instances and each would hold its
# own connection open.
#   postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# If the password contains @ : / ? # it must be percent-encoded.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Security ---
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it every deploy uses the same public default, and anyone can
# forge a login cookie.
SECRET_KEY=paste-a-long-random-string-here

# --- Login ---
# Only used to set the password the very first time the database is created.
# He should change it in Settings afterwards, and you can remove these two
# from Vercel once he has.
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-before-sharing-the-link

# --- Optional ---
# 1 loads sample trading data so the screens have something to show. It only
# writes to an empty database, and it stamps a banner so nobody mistakes the
# figures for real accounts. Leave at 0 for his actual store.
SEED_DEMO_DATA=0

# Set to 0 only if you are serving over plain http somewhere, which would
# mean the login cookie is not marked Secure.
SESSION_COOKIE_SECURE=1
